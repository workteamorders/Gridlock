# Public build-time variables. None of these is a secret: they end up in the bundle.
NEXT_PUBLIC_CHAIN_ID=46630
# Direct RPC URL for LOCAL testing only. Leave unset in production: reads go through /api/rpc.
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SITE_URL=https://gridlock.example
# Set to 1 only for the real production site.
NEXT_PUBLIC_INDEXABLE=0
NEXT_PUBLIC_AUDIT_REPORT_URL=
NEXT_PUBLIC_CONTACT_URL=

# Function variables, runtime only (set in the Vercel project settings, or the Cloudflare dashboard; never in the repo):
#   UPSTREAM_RPC_URL     the real RPC endpoint, including any key. Secret.
#   CONTRACT_ADDRESSES   comma-separated list of the cars contract (and renderer) addresses the relay may call
#   ALLOWED_ORIGINS      optional extra origins allowed to call /api/rpc
#   BLOCKED_COUNTRIES    optional comma-separated ISO country codes for view-only mode
